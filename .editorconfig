# EditorConfig — consistent coding style across editors & IDEs
# https://editorconfig.org
# Equivalent to .editorconfig in Python projects

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
