# ============================================
# EduCard Mobile App Environment Configuration (React Native CLI)
# ============================================
#
# USAGE:
# - Copy this file to .env.local for local development and .env.production for release
# - Select an env file at build/run time with react-native-config:
#     ENVFILE=.env.local pnpm android
#     ENVFILE=.env.production pnpm android
#
# API URL Guidelines:
# - Android Emulator: http://10.0.2.2:8000/api (maps to host localhost)
# - iOS Simulator: http://localhost:8000/api
# - Physical Device: http://<YOUR_LAN_IP>:8000/api (e.g., 192.168.2.100)
# - Production: https://educard-backend-api-272236662775.asia-south1.run.app/api

API_URL=http://10.0.2.2:8000/api
APP_ENV=development
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=
