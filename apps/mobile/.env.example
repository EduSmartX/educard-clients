# ============================================
# EduCard Mobile - Environment Configuration (React Native CLI)
# ============================================
#
# react-native-config reads a .env file at BUILD time and exposes the values via
# `import Config from 'react-native-config'` (see src/constants/config.ts).
#
# The Android build picks the file automatically by build type
# (android/app/build.gradle -> project.ext.envConfigFiles):
#   debug builds   (pnpm android / assembleDebug)    -> .env.local      (local backend)
#   release builds (assembleRelease / bundleRelease) -> .env.production (EduCard backend)
#
# SETUP on a new machine (these files are gitignored, so create them):
#   cp .env.example .env.local        # local backend (keep the local API_URL below)
#   cp .env.example .env.production   # then set API_URL to the EduCard backend
#
# OVERRIDE the file for one command with ENVFILE:
#   bash/macOS/Linux : ENVFILE=.env.production pnpm android
#   PowerShell       : $env:ENVFILE=".env.production"; pnpm android
#   Windows cmd      : set ENVFILE=.env.production && pnpm android
#
# API_URL options:
#   Android emulator : http://10.0.2.2:8000/api   (10.0.2.2 = host localhost)
#   iOS simulator    : http://localhost:8000/api
#   Physical device  : http://<YOUR_LAN_IP>:8000/api   (e.g. 192.168.2.100)
#   EduCard (hosted) : https://educard-backend-api-272236662775.asia-south1.run.app/api

# Default below = local backend on an Android emulator.
API_URL=http://10.0.2.2:8000/api
APP_ENV=development

# Optional analytics / monitoring (leave blank if unused)
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=
