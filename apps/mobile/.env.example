# ============================================
# EduCard Mobile App Environment Configuration
# ============================================
#
# USAGE:
# - Copy this file to .env for local development
# - For production builds (APK/Vercel), use .env.production
#
# API URL Guidelines:
# - Android Emulator: http://10.0.2.2:8000/api (maps to host localhost)
# - iOS Simulator: http://localhost:8000/api
# - Physical Device: http://<YOUR_LAN_IP>:8000/api (e.g., 192.168.2.100)
# - Production: https://educard-backend.onrender.com/api
#
# The app auto-detects the correct IP from Expo if EXPO_PUBLIC_API_URL is not set

# Environment
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_DSN=

# Push Notifications (get from Expo dashboard)
EXPO_PUBLIC_PROJECT_ID=your-expo-project-id

# Analytics (optional)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
