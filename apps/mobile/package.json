{
  "name": "@educard/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:local": "cp .env.local .env && expo start",
    "start:prod": "cp .env.production .env && expo start",
    "android": "expo run:android",
    "android:local": "cp .env.local .env && expo start --android",
    "android:prod": "cp .env.production .env && expo start --android",
    "ios": "expo run:ios",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=100",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "typecheck": "tsc --noEmit",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:android:prod": "cp .env.production .env && eas build --platform android"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@educard/shared": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^3.9.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/netinfo": "11.5.2",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "buffer": "^6.0.3",
    "date-fns": "^3.6.0",
    "expo": "~55.0.17",
    "expo-constants": "~55.0.15",
    "expo-device": "~55.0.15",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.20",
    "expo-font": "~55.0.6",
    "expo-image": "~55.0.9",
    "expo-image-picker": "^55.0.19",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.14",
    "expo-location": "~55.1.8",
    "expo-media-library": "^55.0.17",
    "expo-notifications": "~55.0.20",
    "expo-router": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-sharing": "~55.0.19",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.16",
    "expo-updates": "~55.0.21",
    "expo-web-browser": "~55.0.14",
    "lucide-react-native": "^0.454.0",
    "nativewind": "^4.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.53.0",
    "react-native": "0.83.6",
    "react-native-css-interop": "^0.1.12",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.14",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^12.8.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "babel-preset-expo": "^55.0.18",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.16",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.9.3"
  },
  "private": true
}
