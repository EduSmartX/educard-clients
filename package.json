{
  "name": "educard-clients",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @educard/web dev",
    "dev:mobile": "pnpm --filter @educard/mobile start",
    "build:web": "pnpm --filter @educard/web build",
    "build:mobile:ios": "pnpm --filter @educard/mobile build:ios",
    "build:mobile:android": "pnpm --filter @educard/mobile build:android",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "clean": "node -e \"const fs=require('fs');['node_modules','apps/web/node_modules','apps/mobile/node_modules','packages/shared/node_modules'].forEach(d=>{if(fs.existsSync(d)){fs.rmSync(d,{recursive:true,force:true})}})\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@3": "^3.15.0",
      "js-yaml@4": "^4.3.0",
      "fast-uri": "^3.1.5",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "shell-quote@1": "^1.9.0",
      "form-data": "^4.0.6",
      "uuid": "^11.1.1",
      "nanoid@3": "^3.3.18",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0",
      "ws@7": "^7.5.11",
      "ws@8": "^8.21.0",
      "@tootallnate/once": "^2.0.1",
      "fast-xml-parser@<5.7.0": ">=5.7.0"
    }
  }
}
